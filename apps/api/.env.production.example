# ─── Next360 API — production env template ──────────────────────────────────
# Copy this file, fill every value, and paste each variable into your host's
# environment (Railway → Service Variables, or Render → Environment).
# NEVER commit the filled-in file.

# ─── Core ────────────────────────────────────────────────────────────────────
NODE_ENV=production
API_PORT=4000
# CORS — comma-separated origins that may call the API
CORS_ORIGINS=https://next360.com,https://admin.next360.com,https://vendor.next360.com

# ─── Database — Supabase Postgres (REQUIRED) ─────────────────────────────────
# Get these from: Supabase Dashboard → Project (dwjrflijewoxcopgiwmx)
#   → Settings → Database → Connection string → "Direct connection" (for DATABASE_URL)
#   and "Transaction pooler" (optional for DIRECT_URL). You need the DB password.
DATABASE_URL=postgresql://postgres:DB_PASSWORD@db.dwjrflijewoxcopgiwmx.supabase.co:5432/postgres?sslmode=require
DIRECT_URL=postgresql://postgres:DB_PASSWORD@db.dwjrflijewoxcopgiwmx.supabase.co:5432/postgres?sslmode=require

# ─── Supabase API (for storage/realtime/anon flows) ──────────────────────────
# Dashboard → Settings → API keys
SUPABASE_URL=https://dwjrflijewoxcopgiwmx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── Auth ────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET=generate-a-long-random-string
JWT_EXPIRATION=7d

# ─── Redis — BullMQ (Railway Redis plugin, REQUIRED at runtime) ──────────────
REDIS_URL=redis://default:REDIS_PASSWORD@hostname:6379

# ─── Payments — Razorpay ─────────────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_live_xxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-secret
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret

# ─── SMS OTP — MSG91 DLT (REQUIRED for India / TRAI) ──────────────────────────
# Register at https://msg91.com → DLT → get PE ID + Sender ID + template approval
# Template example (must match approved DLT template): "Your Next360 OTP is ##otp##. Valid for 5 minutes. - NXT360"
MSG91_AUTH_KEY=your-msg91-authkey
MSG91_TEMPLATE_ID=your-dlt-template-id
MSG91_SENDER_ID=NXT360
DLT_ENTITY_ID=your-principal-entity-id
# Fallback / staging — Twilio (optional, used if MSG91 not configured)
TWILIO_ACCOUNT_SID=your-account-sid
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx

# ─── Email (optional — notifications) ────────────────────────────────────────
RESEND_API_KEY=
SENDGRID_API_KEY=
# Gmail SMTP (use a Google App Password, not your login password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=noreply@next360.com

# ─── AI features (optional) ──────────────────────────────────────────────────
OPENAI_API_KEY=
GEMINI_API_KEY=

# ─── Monitoring (optional) ───────────────────────────────────────────────────
SENTRY_DSN=
EXPO_ACCESS_TOKEN=your-expo-access-token

# ─── Supabase client key used by the mobile apps (NOT needed by the API) ─────
# EXPO_PUBLIC_SUPABASE_URL / EXPO_PUBLIC_SUPABASE_ANON_KEY live in the mobile
# eas.json / .env — see DEPLOYMENT_GUIDE.md.
