# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:password@localhost:5432/next360?schema=public"

# ─── Supabase ──────────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── Authentication ────────────────────────────────────────────────────────────
JWT_SECRET=your-jwt-secret
JWT_EXPIRATION=7d

# ─── Razorpay ──────────────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-secret
RAZORPAY_WEBHOOK_SECRET=your-webhook-secret

# ─── AI ────────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxx
GEMINI_API_KEY=xxxxxxxxxxxxxxxx

# ─── API Configuration ─────────────────────────────────────────────────────────
API_PORT=4000
CORS_ORIGINS=http://localhost:3001,http://localhost:3002

# ─── Expo Push ─────────────────────────────────────────────────────────────────
EXPO_ACCESS_TOKEN=your-expo-access-token

# ─── Email (SendGrid, Resend, or Gmail SMTP) ───────────────────────────────────
# Gmail SMTP: use an App Password (Google Account → Security → 2-Step
# Verification → App passwords), not your login password.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASS=xxxx-xxxx-xxxx-xxxx
# FROM_EMAIL=you@gmail.com

# ─── Sentry Crash Reporting ──────────────────────────────────────────────────
# Create a React Native project at sentry.io and paste your DSN here
EXPO_PUBLIC_SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
